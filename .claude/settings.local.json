{
  "env": {
    "AWS_REGION": "eu-central-1",
    "AWS_PROFILE": "default"
  },
  "permissions": {
    "allow": [
      "Bash(git init *)",
      "Bash(git checkout *)",
      "Bash(git add *)",
      "Bash(aws sts *)",
      "Bash(terraform plan *)",
      "Bash(terraform show *)",
      "Bash(cd *)",
      "Bash(git commit -q -m 'feat\\(eks\\): enable VPC CNI prefix delegation and scale genai-service to 0 *)",
      "Bash(aws eks *)",
      "Bash(kubectl get *)",
      "Bash(./scripts/install-lb-controller.sh dev *)",
      "Bash(./scripts/install-external-secrets.sh dev *)",
      "Bash(kubectl apply *)",
      "Bash(kubectl wait *)",
      "Bash(git push *)",
      "Bash(gh workflow *)",
      "Bash(gh run *)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "awslabs.terraform-mcp-server",
    "aws-knowledge-mcp",
    "awslabs.aws-pricing-mcp-server",
    "context7",
    "atlassian",
    "terraform-mcp-server"
  ]
}

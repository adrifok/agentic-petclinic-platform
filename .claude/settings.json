{
  "permissions": {
    "deny": [
      "Bash(terraform destroy:*)",
      "Bash(terragrunt destroy:*)",
      "Bash(terragrunt run-all destroy:*)",
      "Bash(tofu destroy:*)",
      "Bash(kubectl delete namespace petclinic-prod:*)",
      "Bash(kubectl delete ns petclinic-prod:*)",
      "mcp__terraform-mcp-server__delete_workspace_safely",
      "mcp__terraform-mcp-server__delete_workspace_variable",
      "mcp__terraform-mcp-server__delete_variable_set",
      "mcp__terraform-mcp-server__delete_variable_from_variable_set"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-destroy.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-rm.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/warn-apply-without-plan.sh"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-secret-commit.sh"
          }
        ]
      },
      {
        "matcher": "mcp__terraform-mcp-server__.*|mcp__.*__ExecuteTerraformCommand|mcp__.*__ExecuteTerragruntCommand",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-mcp-destroy.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/suggest-validate.sh"
          }
        ]
      }
    ]
  }
}
